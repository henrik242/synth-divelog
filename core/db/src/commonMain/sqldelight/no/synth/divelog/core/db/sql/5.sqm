-- The diver's equipment. Dates are days since 1970-01-01, prices in hundredths.
CREATE TABLE gear (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    kind TEXT,
    brand TEXT,
    model TEXT,
    serialNumber TEXT,
    purchasedEpochDay INTEGER,
    purchasePriceCents INTEGER,
    shop TEXT,
    notes TEXT,
    -- 1 when no longer in use.
    retired INTEGER NOT NULL DEFAULT 0
);

-- One service of a piece of gear.
CREATE TABLE gearService (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    gearId INTEGER NOT NULL REFERENCES gear(id) ON DELETE CASCADE,
    epochDay INTEGER NOT NULL,
    notes TEXT
);

CREATE INDEX gearService_gear ON gearService(gearId);
