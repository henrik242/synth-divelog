CREATE TABLE diveComputerRecord (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    diveId INTEGER NOT NULL REFERENCES dive(id) ON DELETE CASCADE,
    deviceId INTEGER REFERENCES device(id) ON DELETE SET NULL,
    startEpochSeconds INTEGER NOT NULL,
    durationSeconds INTEGER NOT NULL,
    maxDepthMm INTEGER,
    rawData BLOB NOT NULL,
    rawFormatId TEXT NOT NULL,
    fingerprint TEXT NOT NULL
);

CREATE INDEX record_dive ON diveComputerRecord(diveId);
CREATE INDEX record_fingerprint ON diveComputerRecord(deviceId, fingerprint);

insertRecord:
INSERT INTO diveComputerRecord(diveId, deviceId, startEpochSeconds, durationSeconds, maxDepthMm, rawData, rawFormatId, fingerprint)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

-- Summary columns only (no raw blob), for lists and overview.
selectRecordSummaryById:
SELECT id, diveId, deviceId, startEpochSeconds, durationSeconds, maxDepthMm, rawFormatId, fingerprint
FROM diveComputerRecord WHERE id = ?;

selectRecordSummariesForDive:
SELECT id, diveId, deviceId, startEpochSeconds, durationSeconds, maxDepthMm, rawFormatId, fingerprint
FROM diveComputerRecord WHERE diveId = ? ORDER BY startEpochSeconds;

-- One row per (dive, device) for the whole log, so lists need no per-dive lookups.
-- Device columns are null for records without a device (file imports).
selectDiveSources:
SELECT DISTINCT r.diveId, r.deviceId, d.vendor, d.model, d.serial, d.nickname
FROM diveComputerRecord r LEFT JOIN device d ON d.id = r.deviceId
ORDER BY r.diveId, r.deviceId;

selectRawData:
SELECT rawData FROM diveComputerRecord WHERE id = ?;

-- Duplicate detection: same device plus same fingerprint.
findByDeviceAndFingerprint:
SELECT id, diveId, deviceId, startEpochSeconds, durationSeconds, maxDepthMm, rawFormatId, fingerprint
FROM diveComputerRecord WHERE deviceId = ? AND fingerprint = ? LIMIT 1;

-- Fingerprint of the newest stored dive for a device, for an incremental download
-- (the protocol walks newest-first and stops when it reaches this one).
selectNewestFingerprintForDevice:
SELECT fingerprint FROM diveComputerRecord WHERE deviceId = ?
ORDER BY startEpochSeconds DESC LIMIT 1;

countRecordsForDive:
SELECT count(*) FROM diveComputerRecord WHERE diveId = ?;

reassignRecordToDive:
UPDATE diveComputerRecord SET diveId = ? WHERE id = ?;

reassignRecordsFromDevice:
UPDATE diveComputerRecord SET deviceId = ? WHERE deviceId = ?;

-- Dives per device, for the dive computers page.
countDivesByDevice:
SELECT deviceId, count(DISTINCT diveId) AS dives FROM diveComputerRecord
WHERE deviceId IS NOT NULL GROUP BY deviceId;

deleteRecord:
DELETE FROM diveComputerRecord WHERE id = ?;

lastInsertRowId:
SELECT last_insert_rowid();

updateRecordSummary:
UPDATE diveComputerRecord SET startEpochSeconds = ?, durationSeconds = ?, maxDepthMm = ? WHERE id = ?;
