-- The diver's equipment. Dates are days since 1970-01-01, prices in hundredths.
CREATE TABLE gear (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    kind TEXT,
    brand TEXT,
    model TEXT,
    serialNumber TEXT,
    purchasedEpochDay INTEGER,
    purchasePriceCents INTEGER,
    shop TEXT,
    notes TEXT,
    -- 1 when no longer in use.
    retired INTEGER NOT NULL DEFAULT 0,
    -- The downloaded dive computer this is, if it is one.
    deviceId INTEGER REFERENCES device(id) ON DELETE SET NULL
);

CREATE UNIQUE INDEX gear_device ON gear(deviceId);

-- One service of a piece of gear.
CREATE TABLE gearService (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    gearId INTEGER NOT NULL REFERENCES gear(id) ON DELETE CASCADE,
    epochDay INTEGER NOT NULL,
    notes TEXT
);

CREATE INDEX gearService_gear ON gearService(gearId);

-- The gear used on a dive.
CREATE TABLE diveGear (
    diveId INTEGER NOT NULL REFERENCES dive(id) ON DELETE CASCADE,
    gearId INTEGER NOT NULL REFERENCES gear(id) ON DELETE CASCADE,
    PRIMARY KEY (diveId, gearId)
);

CREATE INDEX diveGear_gear ON diveGear(gearId);

insertGear:
INSERT INTO gear(name, kind, brand, model, serialNumber, purchasedEpochDay, purchasePriceCents, shop, notes, retired, deviceId)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updateGear:
UPDATE gear SET name = ?, kind = ?, brand = ?, model = ?, serialNumber = ?, purchasedEpochDay = ?,
    purchasePriceCents = ?, shop = ?, notes = ?, retired = ?, deviceId = ?
WHERE id = ?;

deleteGear:
DELETE FROM gear WHERE id = ?;

selectAllGear:
SELECT * FROM gear ORDER BY name COLLATE NOCASE, id;

selectGearById:
SELECT * FROM gear WHERE id = ?;

selectGearByDevice:
SELECT * FROM gear WHERE deviceId = ?;

-- Moves one piece's services and dives to another, for when they turn out to be one. The
-- dives are copied; deleting the first piece then drops its own links.
moveServices:
UPDATE gearService SET gearId = :toGearId WHERE gearId = :fromGearId;

copyGearDives:
INSERT OR IGNORE INTO diveGear(diveId, gearId) SELECT diveId, :toGearId FROM diveGear WHERE gearId = :fromGearId;

insertService:
INSERT INTO gearService(gearId, epochDay, notes) VALUES (?, ?, ?);

updateService:
UPDATE gearService SET epochDay = ?, notes = ? WHERE id = ?;

deleteService:
DELETE FROM gearService WHERE id = ?;

-- Newest first.
selectServicesForGear:
SELECT * FROM gearService WHERE gearId = ? ORDER BY epochDay DESC, id DESC;

-- The latest service per piece of gear.
selectLastServices:
SELECT gearId, max(epochDay) AS epochDay FROM gearService GROUP BY gearId;

linkDiveGear:
INSERT OR IGNORE INTO diveGear(diveId, gearId) VALUES (?, ?);

unlinkDiveGear:
DELETE FROM diveGear WHERE diveId = ? AND gearId = ?;

selectGearForDive:
SELECT gear.* FROM gear
JOIN diveGear ON diveGear.gearId = gear.id
WHERE diveGear.diveId = ?
ORDER BY gear.name COLLATE NOCASE, gear.id;

-- Gear on dives: linked by hand, and a dive computer on the dives it logged.
selectDiveGearLinks:
SELECT diveId, gearId FROM diveGear
UNION
SELECT diveComputerRecord.diveId, gear.id FROM diveComputerRecord JOIN gear ON gear.deviceId = diveComputerRecord.deviceId;

selectDiveIdsForGear:
SELECT diveId FROM diveGear WHERE gearId = :gearId
UNION
SELECT diveComputerRecord.diveId FROM diveComputerRecord JOIN gear ON gear.deviceId = diveComputerRecord.deviceId WHERE gear.id = :gearId;

-- Dive computers not linked to a downloaded one yet, by serial.
selectUnlinkedComputersBySerial:
SELECT * FROM gear WHERE kind = 'COMPUTER' AND deviceId IS NULL AND serialNumber = ? ORDER BY id;

-- Copies one dive's gear onto another, skipping what it already has.
copyDiveGear:
INSERT OR IGNORE INTO diveGear(diveId, gearId) SELECT :targetDiveId, gearId FROM diveGear WHERE diveId = :sourceDiveId;

lastInsertRowId:
SELECT last_insert_rowid();
