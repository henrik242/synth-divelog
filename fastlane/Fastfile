default_platform(:ios)

TEAM_ID = "358L7UXVJ4"
APP_IDENTIFIER = "no.synth.divelog"
PROJECT = "iosApp/iosApp.xcodeproj"
SCHEME = "iosApp"
IPA_NAME = "SynthDivelog.ipa"

platform :android do
  lane :deploy do
    submit = ENV["SUBMIT_FOR_REVIEW"] != "false"
    upload_to_play_store(
      package_name: APP_IDENTIFIER,
      track: ENV["PLAY_TRACK"] || "internal",
      release_status: submit ? "completed" : "draft",
      aab: "app/android/build/outputs/bundle/release/android-release.aab",
      json_key: ENV["GOOGLE_PLAY_SERVICE_ACCOUNT_JSON_PATH"],
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end
end

platform :ios do
  lane :build do
    setup_ci if ENV["CI"]

    cert_path = ENV["DISTRIBUTION_CERTIFICATE_PATH"]
    if cert_path
      import_certificate(
        certificate_path: cert_path,
        certificate_password: ENV["DISTRIBUTION_CERTIFICATE_PASSWORD"],
        certificate_format: "pkcs12",
        keychain_name: ENV["MATCH_KEYCHAIN_NAME"] || "login",
        keychain_password: ENV["MATCH_KEYCHAIN_PASSWORD"] || "",
        log_output: true
      )
    end

    profile_path = ENV["PROVISIONING_PROFILE_PATH"]
    install_provisioning_profile(path: profile_path) if profile_path

    profile_name = ENV["PROFILE_NAME"] || ""

    # Manual signing on the app target only; the project defaults to automatic for local runs.
    unless profile_name.empty?
      update_code_signing_settings(
        path: PROJECT,
        targets: [SCHEME],
        use_automatic_signing: false,
        team_id: TEAM_ID,
        code_sign_identity: "iPhone Distribution",
        profile_name: profile_name
      )
    end

    build_app(
      project: PROJECT,
      scheme: SCHEME,
      configuration: "Release",
      export_method: "app-store",
      output_directory: ENV["OUTPUT_DIR"] || "./build",
      output_name: IPA_NAME,
      destination: "generic/platform=iOS",
      skip_profile_detection: true,
      export_options: {
        method: "app-store",
        teamID: TEAM_ID,
        signingStyle: "manual",
        signingCertificate: "iPhone Distribution",
        uploadSymbols: true,
        provisioningProfiles: {
          APP_IDENTIFIER => profile_name
        }
      }
    )
  end

  lane :deploy do
    submit = ENV["SUBMIT_FOR_REVIEW"] != "false"
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_filepath: ENV["ASC_KEY_PATH"]
    )

    options = {
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      ipa: ENV["IPA_PATH"],
      skip_screenshots: true,
      skip_metadata: !submit,
      force: true,
      submit_for_review: submit,
      automatic_release: submit,
      precheck_include_in_app_purchases: false,
      release_notes: { "en-US" => ENV["WHATS_NEW_EN"] || "Bug fixes and improvements." }
    }

    # App Store Connect rejects the review submission unless the App Review contact
    # is set on the version. Phone must be +countrycode, e.g. +4712345678.
    contact_email = ENV["ASC_CONTACT_EMAIL"]
    if submit && contact_email && !contact_email.empty?
      options[:app_review_information] = {
        first_name: ENV["ASC_CONTACT_FIRST_NAME"],
        last_name: ENV["ASC_CONTACT_LAST_NAME"],
        phone_number: ENV["ASC_CONTACT_PHONE"],
        email_address: contact_email
      }
    end

    upload_to_app_store(options)
  end
end
